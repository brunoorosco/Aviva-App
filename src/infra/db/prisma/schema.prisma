model Churches {
  id     String  @id @default(cuid())
  name   String  @db.VarChar(50)
  street String? @db.VarChar(50)
  number String? @db.VarChar(10)
  city   String? @db.VarChar(20)
  state  String? @db.VarChar(15)
  cep    String? @db.VarChar(8)

  @@map("churches")
}

model Address {
  id      String  @id @default(cuid())
  street  String? @db.VarChar(50)
  number  String? @db.VarChar(10)
  city    String? @db.VarChar(20)
  state   String? @db.VarChar(15)
  cep     String? @db.VarChar(8)
  user_id String
  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  // @@index([user_id])
  @@map("address")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  user_id      String
  expires      DateTime
  user         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  // @@index([user_id])
  @@map("session")
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String?   @unique
  email_verified DateTime?
  birth          DateTime? @db.Date
  image          String?
  password       String
  address        Address[]
  sessions       Session[]
  UserCEM        UserCEM[]

  @@map("user")
}

model CEM {
  id      String    @id @default(cuid())
  name    String    @db.VarChar(50)
  street  String?   @db.VarChar(50)
  number  String?   @db.VarChar(10)
  city    String?   @db.VarChar(20)
  state   String?   @db.VarChar(15)
  cep     String?   @db.VarChar(8)
  UserCEM UserCEM[]

  @@map("cem")
}

model UserCEM {
  user_id     String
  cem_id      String
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  cem         CEM      @relation(fields: [cem_id], references: [id], onDelete: Cascade)
  inserted_at DateTime @default(now())

  @@id([user_id, cem_id])
  // @@index([user_id])
  // @@index([cem_id])
  @@map("usercem")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_token")
}
