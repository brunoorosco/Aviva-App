generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
  relationMode      = "prisma"
}

enum Actions {
  create
  read
  delete
  update
}

model Churches {
  id          String        @id @default(cuid())
  name        String        @db.VarChar(50)
  street      String?       @db.VarChar(50)
  number      String?       @db.VarChar(10)
  city        String?       @db.VarChar(20)
  state       String?       @db.VarChar(15)
  cep         String?       @db.VarChar(8)
  ChurchesCEM ChurchesCEM[]

  @@map("churches")
}

model Address {
  id      String  @id @default(cuid())
  street  String? @db.VarChar(50)
  number  String? @db.VarChar(10)
  city    String? @db.VarChar(20)
  state   String? @db.VarChar(15)
  cep     String? @db.VarChar(8)
  user_id String
  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id])
  @@map("address")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  user_id      String
  expires      DateTime
  user         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("session")
}

model User {
  id             String      @id @default(cuid())
  name           String?
  email          String?     @unique
  email_verified DateTime?
  birth          DateTime?   @db.Date
  image          String?
  password       String
  address        Address[]
  sessions       Session[]
  UserCEM        UserCEM[]
  UserRules      UserRules[]

  @@map("user")
}

model CEM {
  id          String        @id @default(cuid())
  name        String        @db.VarChar(50)
  street      String?       @db.VarChar(50)
  number      String?       @db.VarChar(10)
  city        String?       @db.VarChar(20)
  state       String?       @db.VarChar(15)
  cep         String?       @db.VarChar(8)
  UserCEM     UserCEM[]
  ChurchesCEM ChurchesCEM[]

  @@map("cem")
}

model UserCEM {
  user_id     String
  cem_id      String
  inserted_at DateTime @default(now())
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  cem         CEM      @relation(fields: [cem_id], references: [id], onDelete: Cascade)

  @@id([user_id, cem_id])
  @@index([user_id])
  @@index([cem_id])
  @@map("usercem")
}

model ChurchesCEM {
  churches_id String
  cem_id      String
  inserted_at DateTime @default(now())
  churches    Churches @relation(fields: [churches_id], references: [id], onDelete: Cascade)
  cem         CEM      @relation(fields: [cem_id], references: [id], onDelete: Cascade)

  @@id([churches_id, cem_id])
  @@unique([cem_id])
  @@index([churches_id])
  @@index([cem_id])
  @@map("churchescem")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_token")
}

model Rules {
  id        String      @id @default(cuid())
  ations    Actions
  subject   String
  UserRules UserRules[]

  @@map("rules")
}

model UserRules {
  user_id  String
  rules_id String
  user     User   @relation(fields: [user_id], references: [id])
  rules    Rules  @relation(fields: [rules_id], references: [id])

  @@id([user_id, rules_id])
  @@index([user_id])
  @@index([rules_id])
  @@map("userrules")
}
